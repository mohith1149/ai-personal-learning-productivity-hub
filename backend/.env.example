# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
# DATABASE_URL=sqlite:///D:/projects/project/PROJECTS/ai-learning-hub/backend/data/hub.db
# Future PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/hub

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# internal | n8n | off
SCHEDULER_MODE=internal
# Shared secret n8n sends as X-Automation-Key
AUTOMATION_API_KEY=

# Email: none | smtp | gmail_api
EMAIL_PROVIDER=none
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASSWORD=
EMAIL_FROM=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Callback URL: http://localhost:8000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# YouTube Data API v3 key (Google Cloud Console). Backend only; used to import channels and playlists.
YOUTUBE_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
