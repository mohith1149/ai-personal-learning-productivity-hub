# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
# DATABASE_URL=sqlite:///D:/projects/project/PROJECTS/ai-learning-hub/backend/data/hub.db
# Future PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/hub

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# internal | n8n | off
SCHEDULER_MODE=internal
# Shared secret n8n sends as X-Automation-Key
AUTOMATION_API_KEY=

# Email: none | smtp | gmail_api
EMAIL_PROVIDER=none
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASSWORD=
EMAIL_FROM=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Callback URL: http://localhost:8000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional personal access token (read-only "Contents" scope). Only needed to verify commits in PRIVATE repos.
GITHUB_TOKEN=

# YouTube Data API v3 key (Google Cloud Console). Backend only; used to import channels and playlists.
YOUTUBE_API_KEY=

# AI assistant. AI is off unless AI_PROVIDER names a provider AND that provider's key is set.
# groq: FREE tier with generous limits (key from https://console.groq.com/keys). gemini: free but only a few requests a minute
# (key from https://aistudio.google.com/apikey). anthropic: pay-as-you-go.
# AI_PROVIDER is the DEFAULT. Every provider that has a key also appears in the chat's model menu.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
